# Cloudflare statik varlık başlıkları.
# `public/` içeriği dışa aktarma sırasında `out/` köküne kopyalanır.

# Open Graph görseli uzantısız bir dosya olarak üretildiği için içerik tipi
# elle belirtilmelidir; aksi halde sosyal medya önizlemeleri görseli reddeder.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# İçerik özetli (hash'li) varlıklar süresiz önbelleğe alınabilir.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
